DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
POSTGRES_USER=forge
POSTGRES_PASSWORD=your-secure-db-password
POSTGRES_DB=forge

# Email (SMTP) - required for OTP verification and password reset
