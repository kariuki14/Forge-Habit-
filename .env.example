DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
POSTGRES_USER=forge
POSTGRES_PASSWORD=your-secure-db-password
POSTGRES_DB=forge

# Email (SMTP) - required for OTP verification and password reset
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="noreply@forge.app"
APP_URL="http://localhost:3000"
SEED_DEMO_PASSWORD="your-seed-demo-password"

# Google OAuth - create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${APP_URL}/api/auth/oauth/callback/google
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# Key-encryption-key for PII envelope encryption (32 bytes, base64).
# Generate with: openssl rand -base64 32
# NOTE: rotating/losing this key makes all encrypted user PII unrecoverable.
DATA_ENCRYPTION_KEY="generate-a-32-byte-base64-key"